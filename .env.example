# ─── Aplikácia ───────────────────────────────────────────────
NODE_ENV=development
# Verejná adresa portálu (bez lomky na konci) – používa sa v OpenGraph, emailoch a OAuth redirectoch
APP_URL=http://localhost:3000
# Port, na ktorom beží Next.js server v kontajneri
PORT=3000

# ─── PostgreSQL 16 ───────────────────────────────────────────
POSTGRES_USER=omsi
POSTGRES_PASSWORD=omsi_dev_heslo_zmen_ma
POSTGRES_DB=omsi_depo
DATABASE_URL=postgresql://omsi:omsi_dev_heslo_zmen_ma@localhost:5432/omsi_depo?schema=public
# Maximálny počet spojení v poole Prisma (na jednu inštanciu aplikácie)
DATABASE_POOL_MAX=20

# Ukážkové dáta (účty, mody so skutočnými súbormi) pri prvom spustení – v produkcii nastav false
SEED_DEMO_DATA=true

# ─── Redis 7 (rate limiting, deduplikácia stiahnutí) ─────────
REDIS_URL=redis://localhost:6379/0

# ─── Kryptografické tajomstvá ────────────────────────────────
# Vygeneruj: openssl rand -base64 48
AUTH_SECRET=zmen-ma-na-nahodny-retazec-minimalne-32-znakov-dlhy
# Kľúč na podpisovanie jednorazových download tokenov (HMAC-SHA256)
DOWNLOAD_TOKEN_SECRET=zmen-ma-na-iny-nahodny-retazec-minimalne-32-znakov
# Soľ pre hashovanie IP adries (nikdy neukladáme surové IP)
IP_HASH_SECRET=zmen-ma-na-treti-nahodny-retazec-minimalne-32-znakov
# Hlavička, z ktorej sa číta IP klienta za reverznou proxy (x-forwarded-for, x-real-ip, cf-connecting-ip)
# Berie sa POSLEDNÁ hodnota – tú pridala tvoja proxy, nie klient.
# V Dockeri ju vždy nastavuje brána (x-real-ip v docker-compose.yml), táto hodnota platí pre `npm run dev/start`.
CLIENT_IP_HEADER=x-forwarded-for
# Docker brána: adresy proxy, ktorým sa verí hlavička X-Forwarded-For. Bez vlastnej proxy nechaj prázdne,
# za Caddy/nginx na hostiteľovi alebo Cloudflare Tunnelom nastav private_ranges.
TRUSTED_PROXIES=

# ─── Discord OAuth2 (voliteľné – ak je prázdne, tlačidlo sa nezobrazí) ─
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ─── Email (Mailpit lokálne, SMTP v produkcii) ───────────────
# Mailpit: localhost/1025 pre `npm run dev`, v Dockeri mailpit/1025 (nastaví scripts/setup.sh).
# Skutočné odosielanie, napr. Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="OMSI Depo <noreply@omsi-depo.local>"

# ─── VirusTotal (antivírusová kontrola zverejnených súborov) ─
# Bezplatný kľúč: virustotal.com → Sign up → profil (vpravo hore) → API key. Prázdne = kontrola vypnutá.
VIRUSTOTAL_API_KEY=
# Limity bezplatného API (4/min, 500/deň); s platenou licenciou ich zvýš
VIRUSTOTAL_REQUESTS_PER_MINUTE=4
VIRUSTOTAL_DAILY_LIMIT=480

# ─── Vyhľadávače ─────────────────────────────────────────────
# Kód z Google Search Console → Pridať vlastníctvo → Predpona URL → Značka HTML (iba hodnota content="…")
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools (voliteľné)
BING_SITE_VERIFICATION=

# ─── Právne stránky (/ochrana-sukromia, /podmienky, /kontakt) ─
# Meno/názov prevádzkovateľa (GDPR vyžaduje uviesť, kto spracúva údaje), napr. „Ján Novák, Bratislava“
LEGAL_OPERATOR_NAME=
# Kontakt pre GDPR, autorské práva a bezpečnosť; prázdne = kontakt@<doména z APP_URL>
CONTACT_EMAIL=
# Pozvánka na Discord server (https://discord.gg/…) – pätička webu a podpis v emailoch
PUBLIC_DISCORD_URL=

# ─── Cloudflare Turnstile ────────────────────────────────────
# Testovacie kľúče Cloudflare (vždy prejdú) – v produkcii nahraď vlastnými
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ─── Úložisko súborov ────────────────────────────────────────
# LOCAL_DISK (predvolené) alebo S3_COMPATIBLE
STORAGE_DRIVER=LOCAL_DISK
# Koreň úložiska mimo public/ (v Dockeri trvalý volume /data/storage)
STORAGE_LOCAL_ROOT=./storage
# S3 / Cloudflare R2 / MinIO – použije sa iba pri STORAGE_DRIVER=S3_COMPATIBLE
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Limity uploadu ──────────────────────────────────────────
# Maximálna veľkosť jedného súboru modu v bajtoch (8 GiB)
UPLOAD_MAX_FILE_BYTES=8589934592
# Veľkosť jedného chunku v bajtoch (16 MiB)
UPLOAD_CHUNK_BYTES=16777216
# Maximálna veľkosť screenshotu v bajtoch (15 MiB)
UPLOAD_MAX_IMAGE_BYTES=15728640
# Nedokončené uploady sa automaticky zmažú po tomto počte hodín
UPLOAD_EXPIRY_HOURS=24

# ─── Kontrola archívov ───────────────────────────────────────
# Oficiálny 7-Zip (7zz) na čítanie .7z/.rar – v Docker obraze je predinštalovaný.
# Ak binárka chýba, .7z/.rar archívy idú na manuálnu kontrolu moderátorom (ZIP sa kontroluje vždy).
SEVEN_ZIP_PATH=7zz
# Ochrana proti „zip bombám“: max. počet súborov a rozbalená veľkosť (64 GiB)
ARCHIVE_MAX_ENTRIES=200000
ARCHIVE_MAX_UNCOMPRESSED_BYTES=68719476736
